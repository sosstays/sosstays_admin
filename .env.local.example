# Supabase (SOS Stays Database project, id xqqkofbpqntdtfrvxdzo)
SUPABASE_URL=https://xqqkofbpqntdtfrvxdzo.supabase.co
# Service role key — server-side only, bypasses RLS. Get it from
# Supabase dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the whole dashboard (single set of credentials, no per-user accounts)
DASHBOARD_PASSWORD=

# Random 32+ char secret used to sign the session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=
